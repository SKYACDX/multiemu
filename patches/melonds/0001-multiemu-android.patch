 #define PWRITE_16(p, v)     *(u16*)p = v; p += 2;
@@ -261,8 +260,22 @@ int WifiAP::HandleManagementFrame(const u8* data, int len)
 
 int WifiAP::SendPacket(const u8* data, int len)
 {
-    if (data[9] != APChannel)
-        return 0;
+    // Upstream pinned the AP to channel 6 and dropped anything the DS
+    // sent from another one -- faithful to a real access point, and fatal
+    // to any game whose site survey doesn't happen to visit 6. Pokemon
+    // Black scans 1, 7 and 13 only: measured on device, 611 frames in a
+    // row rejected as "bad channel 6", the DS never associating and the
+    // game hanging on "searching for gift" forever. The DS's own receive
+    // path drops frames tagged with a channel it isn't tuned to
+    // (Wifi.cpp), so a fixed-channel AP is simply invisible to those
+    // games.
+    //
+    // There's no radio here to be on a channel, so follow the DS instead:
+    // every frame it sends carries the channel it sent it on, and replies
+    // (and the next beacon) go back out tagged the same way. A game that
+    // does tune to 6 behaves exactly as before.
+    if (data[9] != 0)
+        APChannel = data[9];
 
     data += 12;
 
