+void GLCompositor::BlitOutputToScreen(int buf, const ScreenRect& top, const ScreenRect& bottom, int surfaceHeight) noexcept
+{
+    // Source layout inside CompScreenOutputTex, in GL's bottom-left-origin
+    // space: rows 0..192*Scale are the *top* screen, then 2*Scale rows of
+    // padding, then the bottom screen (see SetScaleFactor's vertex setup).
+    const int screenH = 192 * Scale;
+    const int padding = 2 * Scale;
+
+    // Same unbind ReadOutputScreenAsync needs, and for the same reason:
+    // the compositor's draw call leaves its output texture bound, and
+    // reading from a texture that is simultaneously the blit source is a
+    // feedback loop -- GL_INVALID_OPERATION, which fails the blit and
+    // leaves only the clear below, i.e. a black screen.
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, CompScreenOutputFB[buf]);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+
+    glDisable(GL_SCISSOR_TEST);
+    glClearColor(0.f, 0.f, 0.f, 1.f);
+    glClear(GL_COLOR_BUFFER_BIT);
+
+    auto blit = [&](int srcY0, int srcY1, const ScreenRect& dst) {
+        // srcY0 is the row holding the image's *visual top* (the
+        // compositor renders each screen vertically flipped relative to
+        // GL's bottom-left origin -- confirmed by reading the output back
+        // and looking at it, not just from the vertex math). Passing the
+        // destination's top edge first and bottom edge second is what
+        // asks glBlitFramebuffer for that vertical flip.
+        const int dstTop = surfaceHeight - dst.y;
+        const int dstBottom = surfaceHeight - (dst.y + dst.h);
+        // GL_NEAREST, not GL_LINEAR: matches the Paint(isFilterBitmap =
+        // false) the Canvas path this replaces used, so upscaling stays
+        // crisp/pixelated rather than going blurry.
+        glBlitFramebuffer(0, srcY0, ScreenW, srcY1,
+                          dst.x, dstTop, dst.x + dst.w, dstBottom,
+                          GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    };
+
+    blit(0, screenH, top);
+    blit(screenH + padding, screenH + padding + screenH, bottom);
+}
+
+bool GLCompositor::ReadOutputScreenAsync(int buf, void* dst) noexcept
+{
+    // If a read issued on a *previous* call has landed by now (it's had a
+    // whole frame to do so), grab it before issuing this frame's. First
+    // call ever (nothing pending yet) leaves dst untouched and returns
+    // false -- same one-frame-behind tradeoff GLRenderer's own
+    // PrepareCaptureFrame/GetLine pair already makes (GPU3D_OpenGL.cpp).
+    bool gotData = false;
+    if (ReadbackPending)
+    {
+        glBindBuffer(GL_PIXEL_PACK_BUFFER, ReadbackPBO);
+        void* mapped = glMapBufferRange(GL_PIXEL_PACK_BUFFER, 0, static_cast<GLsizeiptr>(ScreenW) * ScreenH * 4, GL_MAP_READ_BIT);
+        if (mapped)
+        {
+            memcpy(dst, mapped, static_cast<size_t>(ScreenW) * ScreenH * 4);
+            gotData = true;
+        }
+        glUnmapBuffer(GL_PIXEL_PACK_BUFFER);
+    }
+
+    // Clearing bindings the compositor's own draw call left behind (its
+    // output texture as an implicit render target) before reading is
+    // required, not just tidy -- without it glReadPixels raised
+    // GL_INVALID_OPERATION on ANGLE/D3D11 (confirmed via glGetError while
+    // bringing this up on desktop) even though the source framebuffer
+    // itself reported GL_FRAMEBUFFER_COMPLETE.
+    glBindTexture(GL_TEXTURE_2D, 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, CompScreenOutputFB[buf]);
+    glReadBuffer(GL_COLOR_ATTACHMENT0);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, ReadbackPBO);
+    // NULL destination with a PIXEL_PACK_BUFFER bound queues this
+    // transfer and returns immediately, no CPU/GPU sync -- unlike the
+    // glFinish()+direct-pointer version this replaces, which confirmed
+    // via on-device simpleperf profiling to be a real, avoidable stall
+    // (every frame serializing the CPU behind the GPU), not a
+    // theoretical one.
+    glReadPixels(0, 0, ScreenW, ScreenH, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    glBindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    ReadbackPending = true;
+
+    return gotData;
+}
+
 void GLCompositor::RenderFrame(const GPU& gpu, Renderer3D& renderer) noexcept
 {
     int backbuf = gpu.FrontBuffer ^ 1;
