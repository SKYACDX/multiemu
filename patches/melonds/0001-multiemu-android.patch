diff --git a/src/GPU3D_OpenGL.cpp b/src/GPU3D_OpenGL.cpp
index 706c75e..5b1f80b 100644
--- a/src/GPU3D_OpenGL.cpp
+++ b/src/GPU3D_OpenGL.cpp
@@ -28,6 +28,34 @@
 namespace melonDS
 {
 
+// GL_UNSIGNED_SHORT_1_5_5_5_REV (desktop-only, no GLES core or extension
+// equivalent -- confirmed by testing, not just by its absence from GLES
+// headers) let desktop GL read the DS's native ABGR1555 VRAM palette
+// bytes straight into a GL_RGB5_A1 texture with no CPU-side unpacking.
+// On GLES the combination is simply invalid: the driver silently no-ops
+// the upload (no GL error, nothing in logcat), so TexPalMem keeps
+// whatever it was cleared to -- every textured polygon's palette lookup
+// then reads back black/transparent forever, while untextured
+// (vertex-colored) geometry, which never touches this texture, renders
+// fine. Unpacking each 16-bit ABGR1555 entry into real 8-bit RGBA on the
+// CPU and uploading with GL_UNSIGNED_BYTE sidesteps the packed-type
+// question entirely -- every GL/GLES implementation supports that combo.
+static void UnpackABGR1555(const u8* src, u8* dstRGBA8, u32 numPixels)
+{
+    for (u32 i = 0; i < numPixels; i++)
+    {
